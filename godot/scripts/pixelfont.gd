extends RefCounted
## A tiny 3x5 pixel font for the 8-bit LSMG screens. draw_text() paints each
## lit pixel as a square of `px` screen pixels.

const GLYPHS := {
	"A": "010101111101101", "B": "110101110101110", "C": "011100100100011", "D": "110101101101110", "E": "111100110100111",
	"F": "111100110100100", "G": "011100101101011", "H": "101101111101101", "I": "111010010010111", "J": "001001001101010",
	"K": "101101110101101", "L": "100100100100111", "M": "101111111101101", "N": "110101101101101", "O": "010101101101010",
	"P": "110101110100100", "Q": "010101101110011", "R": "110101110101101", "S": "011100010001110", "T": "111010010010010",
	"U": "101101101101111", "V": "101101101101010", "W": "101101111111101", "X": "101101010101101", "Y": "101101010010010",
	"Z": "111001010100111", "0": "111101101101111", "1": "010110010010111", "2": "110001010100111", "3": "110001010001110",
	"4": "101101111001001", "5": "111100110001110", "6": "011100111101111", "7": "111001010010010", "8": "111101111101111",
	"9": "111101111001110", " ": "000000000000000", "!": "010010010000010", ":": "000010000010000", "-": "000000111000000",
	".": "000000000000010", "?": "110001010000010", "+": "000010111010000", "/": "001001010100100", "'": "010010000000000",
	"x": "000101010101000", "<": "001010100010001", ">": "100010001010100", "#": "101111101111101",
}


static func width(text: String, px: float) -> float:
	return text.length() * 4.0 * px - px


static func draw_text(ci: CanvasItem, text: String, pos: Vector2, px: float, col: Color, center := false) -> void:
	var x0 = pos.x - (width(text, px) / 2.0 if center else 0.0)
	var i = 0
	for ch in text.to_upper():
		var g: String = GLYPHS.get(ch, GLYPHS["?"])
		for k in 15:
			if g[k] == "1":
				ci.draw_rect(Rect2(x0 + (i * 4 + k % 3) * px, pos.y + int(k / 3) * px, px, px), col)
		i += 1
